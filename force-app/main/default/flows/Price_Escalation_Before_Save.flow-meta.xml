    <description>Defaults on a Price Escalation before it saves: CS rep from the Account, Notice Days from the org setting, the first Next Increase Date from the contract effective date and escalation start year, and keeps Status in step with the Exclude checkbox.</description>
    <environments>Default</environments>
    <formulas>
        <name>fDefaultNoticeDays</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!$Setup.Price_Increase_Settings__c.Default_Notice_Days__c}, 60)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fFirstIncreaseDate</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!$Record.Contract_Effective_Date__c}, 12 * BLANKVALUE({!$Record.Escalation_Start_Year__c}, 1))</expression>
    </formulas>
