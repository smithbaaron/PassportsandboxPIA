<?xml version='1.0' encoding='UTF-8'?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <decisions>
        <name>Eligible</name>
        <label>Eligible to create?</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <defaultConnector>
            <targetReference>Confirm_Deal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Eligible</defaultConnectorLabel>
        <rules>
            <name>Excluded</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Escalation.Exclude_from_Automatic_Increases__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Escalation.Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Excluded</targetReference>
            </connector>
            <label>Excluded or not Active</label>
        </rules>
        <rules>
            <name>Open_Deal_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Deal</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Exists</targetReference>
            </connector>
            <label>Open deal already linked</label>
        </rules>
    </decisions>
    <decisions>
        <name>Created_OK</name>
        <label>Created?</label>
        <locationX>176</locationX>
        <locationY>500</locationY>
        <defaultConnector>
            <targetReference>Screen_Problem</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Problem</defaultConnectorLabel>
        <rules>
            <name>Yes_Created</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Call_Core.resultCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CREATED</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Screen_Done</targetReference>
            </connector>
            <label>Created</label>
        </rules>
    </decisions>
    <description>Screen flow behind the Create Increase Opp button on a Price Escalation. Shows the clause summary, pre-fills the deal in the team's convention, lets the CS rep adjust name, close date, amount and Revenue Enhancement Type, then creates the deal via the Core flow and links it back.</description>
    <dynamicChoiceSets>
        <name>RevEnhTypeChoices</name>
        <dataType>Picklist</dataType>
        <picklistField>Revenue_Enhancement_Type__c</picklistField>
        <picklistObject>Opportunity</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>fDefaultCloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Get_Escalation.Next_Increase_Date__c}), {!$Flow.CurrentDate} + 30, {!Get_Escalation.Next_Increase_Date__c})</expression>
    </formulas>
    <formulas>
        <name>fIsPercentClause</name>
        <dataType>Boolean</dataType>
        <expression>OR(TEXT({!Get_Escalation.Escalator_Type__c}) = "Fixed Percentage", TEXT({!Get_Escalation.Escalator_Type__c}) = "Percentage Band", TEXT({!Get_Escalation.Escalator_Type__c}) = "CPI-Linked")</expression>
    </formulas>
    <formulas>
        <name>fPercentText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Escalation.Effective_Percentage__c}), "5", IF(FLOOR({!Get_Escalation.Effective_Percentage__c}) = {!Get_Escalation.Effective_Percentage__c}, TEXT(FLOOR({!Get_Escalation.Effective_Percentage__c})), TEXT({!Get_Escalation.Effective_Percentage__c})))</expression>
    </formulas>
    <formulas>
        <name>fDefaultName</name>
        <dataType>String</dataType>
        <expression>LEFT({!Get_Escalation.Account__r.Name} &amp; " - " &amp; IF({!fIsPercentClause}, {!fPercentText} &amp; "% Increase", "Contractual Increase") &amp; " Rev Enhancement - " &amp; TEXT(YEAR({!fDefaultCloseDate})), 120)</expression>
    </formulas>
    <formulas>
        <name>fDefaultAmount</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!Get_Escalation.Estimated_Increase_Amount__c}, BLANKVALUE({!Get_Escalation.Revenue_Impact_Next_Year__c}, 0))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fMappedRevEnhType</name>
        <dataType>String</dataType>
        <expression>CASE(TEXT({!Get_Escalation.Primary_Product__c}), "MPP", "MPP Fee Increase", "CMP", "CMP Fee Increase", "Other")</expression>
    </formulas>
    <formulas>
        <name>fSummaryHtml</name>
        <dataType>String</dataType>
        <expression>"&lt;p&gt;&lt;b&gt;" &amp; {!Get_Escalation.Account__r.Name} &amp; "&lt;/b&gt; &amp;middot; " &amp; TEXT({!Get_Escalation.Escalator_Type__c}) &amp; IF({!fIsPercentClause}, " at " &amp; {!fPercentText} &amp; "%", "") &amp; "&lt;/p&gt;&lt;p&gt;Increase effective &lt;b&gt;" &amp; IF(ISBLANK({!Get_Escalation.Next_Increase_Date__c}), "date not set", TEXT({!Get_Escalation.Next_Increase_Date__c})) &amp; "&lt;/b&gt;, notice due &lt;b&gt;" &amp; IF(ISBLANK({!Get_Escalation.Notice_Due_Date__c}), "not set", TEXT({!Get_Escalation.Notice_Due_Date__c})) &amp; "&lt;/b&gt;. Products: " &amp; BLANKVALUE({!Get_Escalation.Products_Covered_Detail__c}, "see clause") &amp; "&lt;/p&gt;&lt;p&gt;Check the pre-filled deal below and press Next to create it. The deal is created as Type Revenue Enhancement, Lead Source Client Success, owned by the CS rep, and linked back to this clause. Add the opportunity product on the deal before closing it.&lt;/p&gt;"</expression>
    </formulas>
    <formulas>
        <name>fDoneHtml</name>
        <dataType>String</dataType>
        <expression>"&lt;p&gt;" &amp; {!Call_Core.resultMessage} &amp; "&lt;/p&gt;&lt;p&gt;&lt;a href='/" &amp; {!Call_Core.opportunityId} &amp; "' target='_blank'&gt;Open the opportunity&lt;/a&gt;&lt;/p&gt;"</expression>
    </formulas>
    <formulas>
        <name>fExistsHtml</name>
        <dataType>String</dataType>
        <expression>"&lt;p&gt;An increase opportunity is already open for this clause: &lt;a href='/" &amp; {!Get_Open_Deal.Id} &amp; "' target='_blank'&gt;" &amp; {!Get_Open_Deal.Name} &amp; "&lt;/a&gt; (" &amp; TEXT({!Get_Open_Deal.StageName}) &amp; "). Close it before creating another.&lt;/p&gt;"</expression>
    </formulas>
    <formulas>
        <name>fExcludedHtml</name>
        <dataType>String</dataType>
        <expression>"&lt;p&gt;This client is excluded from automatic increases" &amp; IF(ISBLANK({!Get_Escalation.Exclusion_Reason__c}), " (status " &amp; TEXT({!Get_Escalation.Status__c}) &amp; ")", ": " &amp; {!Get_Escalation.Exclusion_Reason__c}) &amp; ".&lt;/p&gt;&lt;p&gt;Clear the exclusion on the Price Escalation first if an increase is due.&lt;/p&gt;"</expression>
    </formulas>
    <formulas>
        <name>fProblemHtml</name>
        <dataType>String</dataType>
        <expression>"&lt;p&gt;The deal was not created: " &amp; {!Call_Core.resultMessage} &amp; "&lt;/p&gt;"</expression>
    </formulas>
    <interviewLabel>Create Increase Opp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Price Escalation - Create Increase Opp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordLookups>
        <name>Get_Escalation</name>
        <label>Get Price Escalation</label>
        <locationX>176</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Open_Deal</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Price_Escalation__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Deal</name>
        <label>Get Open Increase Deal</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Eligible</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Price_Escalation__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <screens>
        <name>Confirm_Deal</name>
        <label>Create Increase Opportunity</label>
        <locationX>176</locationX>
        <locationY>300</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Call_Core</targetReference>
        </connector>
        <fields>
            <name>Summary</name>
            <fieldText>{!fSummaryHtml}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Opp_Name</name>
            <dataType>String</dataType>
            <defaultValue>
                <elementReference>fDefaultName</elementReference>
            </defaultValue>
            <fieldText>Opportunity Name</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Close_Date</name>
            <dataType>Date</dataType>
            <defaultValue>
                <elementReference>fDefaultCloseDate</elementReference>
            </defaultValue>
            <fieldText>Close Date (defaults to the increase effective date)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>Amount</name>
            <dataType>Currency</dataType>
            <defaultValue>
                <elementReference>fDefaultAmount</elementReference>
            </defaultValue>
            <fieldText>Amount (annual revenue the increase adds)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
        </fields>
        <fields>
            <name>Rev_Enh_Type</name>
            <choiceReferences>RevEnhTypeChoices</choiceReferences>
            <dataType>String</dataType>
            <fieldText>Revenue Enhancement Type</fieldText>
            <fieldType>DropdownBox</fieldType>
            <helpText>Leave blank to use the value mapped from the clause's Primary Product.</helpText>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>Mapped_Type_Note</name>
            <fieldText>&lt;p&gt;&lt;i&gt;Mapped from Primary Product: {!fMappedRevEnhType}&lt;/i&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>Notes</name>
            <dataType>String</dataType>
            <fieldText>Notes for the deal description (optional)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <nextOrFinishButtonLabel>Create Opportunity</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Done</name>
        <label>Opportunity Created</label>
        <locationX>50</locationX>
        <locationY>600</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Done_Text</name>
            <fieldText>{!fDoneHtml}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Problem</name>
        <label>Not Created</label>
        <locationX>300</locationX>
        <locationY>600</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Problem_Text</name>
            <fieldText>{!fProblemHtml}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Excluded</name>
        <label>Client Excluded</label>
        <locationX>400</locationX>
        <locationY>300</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Excluded_Text</name>
            <fieldText>{!fExcludedHtml}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Screen_Exists</name>
        <label>Deal Already Open</label>
        <locationX>600</locationX>
        <locationY>300</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Exists_Text</name>
            <fieldText>{!fExistsHtml}</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Escalation</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Call_Core</name>
        <label>Create the deal</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <connector>
            <targetReference>Created_OK</targetReference>
        </connector>
        <flowName>Price_Escalation_Create_Increase_Opp_Core</flowName>
        <inputAssignments>
            <name>amount</name>
            <value>
                <elementReference>Amount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>closeDate</name>
            <value>
                <elementReference>Close_Date</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>escalationId</name>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>notes</name>
            <value>
                <elementReference>Notes</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>oppName</name>
            <value>
                <elementReference>Opp_Name</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>revEnhType</name>
            <value>
                <elementReference>Rev_Enh_Type</elementReference>
            </value>
        </inputAssignments>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </subflows>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>