    <description>Creates one reminder Task per Price Escalation whose notice is coming due (Reminder Lead Days before the Notice Due Date), assigned to the clause's CS rep and tied to the account's Billing Contact (or primary contact; the org requires a contact on every Task), once per cycle. If the account has no contact at all, the CS rep gets the reminder by email instead. Skips excluded and inactive clauses. Called daily by the Notice Reminder scheduled flow; autolaunched so it can be run on demand and tested.</description>
    <environments>Default</environments>
    <formulas>
        <name>fWhoId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Loop_Escalations.Account__r.Billing_Contact__c}), {!Get_Contact.Id}, {!Loop_Escalations.Account__r.Billing_Contact__c})</expression>
    </formulas>
    <formulas>
        <name>fRepEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Loop_Escalations.Client_Success_Rep__c}), {!Loop_Escalations.Account__r.Owner.Email}, {!Loop_Escalations.Client_Success_Rep__r.Email})</expression>
    </formulas>
    <formulas>
        <name>fEmailBody</name>
        <dataType>String</dataType>
        <expression>{!fTaskBody} &amp; BR() &amp; BR() &amp; "(No task could be created because the account has no contact in Salesforce; add the billing contact to the account to get tasks instead of emails.)" &amp; BR() &amp; LEFT({!$Api.Partner_Server_URL_590}, FIND("/services", {!$Api.Partner_Server_URL_590}) - 1) &amp; "/" &amp; {!Loop_Escalations.Id}</expression>
    </formulas>
    <formulas>
        <name>fLeadDays</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!$Setup.Price_Increase_Settings__c.Reminder_Lead_Days__c}, 14)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fNoticeDue</name>
        <dataType>Date</dataType>
        <expression>{!Loop_Escalations.Next_Increase_Date__c} - BLANKVALUE({!Loop_Escalations.Notice_Days__c}, BLANKVALUE({!$Setup.Price_Increase_Settings__c.Default_Notice_Days__c}, 60))</expression>
    </formulas>
    <formulas>
        <name>fIsDue</name>
        <dataType>Boolean</dataType>
        <expression>AND({!fNoticeDue} - {!fLeadDays} &lt;= TODAY(), OR(ISBLANK({!Loop_Escalations.Reminder_Sent_For_Date__c}), {!Loop_Escalations.Reminder_Sent_For_Date__c} &lt;&gt; {!Loop_Escalations.Next_Increase_Date__c}))</expression>
    </formulas>
    <formulas>
        <name>fOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Loop_Escalations.Client_Success_Rep__c}), {!Loop_Escalations.Account__r.OwnerId}, {!Loop_Escalations.Client_Success_Rep__c})</expression>
    </formulas>
    <formulas>
        <name>fSubject</name>
        <dataType>String</dataType>
        <expression>LEFT("Price increase notice due " &amp; TEXT({!fNoticeDue}) &amp; ": " &amp; {!Loop_Escalations.Account__r.Name}, 255)</expression>
    </formulas>
    <formulas>
        <name>fTaskBody</name>
        <dataType>String</dataType>
        <expression>"Contractual price increase for " &amp; {!Loop_Escalations.Account__r.Name} &amp; " takes effect " &amp; TEXT({!Loop_Escalations.Next_Increase_Date__c}) &amp; ". The contract requires " &amp; TEXT(BLANKVALUE({!Loop_Escalations.Notice_Days__c}, 60)) &amp; " days notice, so the notice must go to the client by " &amp; TEXT({!fNoticeDue}) &amp; "." &amp; BR() &amp; BR() &amp; "Clause: " &amp; TEXT({!Loop_Escalations.Escalator_Type__c}) &amp; IF(ISBLANK({!Loop_Escalations.Effective_Percentage__c}), "", " at " &amp; TEXT({!Loop_Escalations.Effective_Percentage__c}) &amp; "%") &amp; ". Products: " &amp; BLANKVALUE({!Loop_Escalations.Products_Covered_Detail__c}, "see clause") &amp; BR() &amp; BR() &amp; "Next steps: send the notice to the client, raise the Finance ticket, then open the Price Escalation (" &amp; {!Loop_Escalations.Name} &amp; ") and press Create Increase Opp to create the Revenue Enhancement opportunity."</expression>
    </formulas>
