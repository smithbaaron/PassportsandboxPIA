    <decisions>
        <name>Applied_Step_Found</name>
        <label>Step applied by this increase?</label>
        <locationX>176</locationX>
        <locationY>700</locationY>
        <defaultConnector>
            <targetReference>Roll_Escalation_Forward</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No step</defaultConnectorLabel>
        <rules>
            <name>Has_Applied_Step</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Applied_Step</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Step_Applied</targetReference>
            </connector>
            <label>Has applied step</label>
        </rules>
    </decisions>
    <description>When a Revenue Enhancement opportunity linked to a Price Escalation closes: Won marks the increase effective, applies the matching Escalation Step, adds its amount to the cumulative total, rolls the Next Increase Date forward (next scheduled step, else one frequency period) and clears the current-cycle fields so the cycle restarts; Lost just unlinks the deal. Completes the clause when the lifetime cap is reached.</description>
    <environments>Default</environments>
    <formulas>
        <name>fEffectiveDate</name>
        <dataType>Date</dataType>
        <expression>BLANKVALUE({!Get_Escalation.Next_Increase_Date__c}, {!$Record.CloseDate})</expression>
    </formulas>
    <formulas>
        <name>fRolledDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!Get_Next_Step.Effective_Date__c}), ADDMONTHS({!fEffectiveDate}, BLANKVALUE({!Get_Escalation.Frequency_Months__c}, 12)), {!Get_Next_Step.Effective_Date__c})</expression>
    </formulas>
    <formulas>
        <name>fStepAmount</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!Get_Applied_Step.Increase_Amount__c}), IF(TEXT({!Get_Escalation.Escalator_Type__c}) = "Fixed Amount per Transaction" || TEXT({!Get_Escalation.Escalator_Type__c}) = "Dollar Cap", BLANKVALUE({!Get_Escalation.Fixed_Increase_Amount__c}, BLANKVALUE({!Get_Escalation.Cap_Per_Increase__c}, 0)), 0), {!Get_Applied_Step.Increase_Amount__c})</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>fNewCumulative</name>
        <dataType>Currency</dataType>
        <expression>BLANKVALUE({!Get_Escalation.Cumulative_Increase_to_Date__c}, 0) + {!fStepAmount}</expression>
        <scale>4</scale>
    </formulas>
    <formulas>
        <name>fNewStatus</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!Get_Escalation.Lifetime_Cap__c})), {!Get_Escalation.Lifetime_Cap__c} &gt; 0, {!fNewCumulative} &gt;= {!Get_Escalation.Lifetime_Cap__c}), "Completed", TEXT({!Get_Escalation.Status__c}))</expression>
    </formulas>
    <formulas>
        <name>fIncreasesApplied</name>
        <dataType>Number</dataType>
        <expression>BLANKVALUE({!Get_Escalation.Increases_Applied__c}, 0) + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Price Escalation Roll Forward {!$Flow.CurrentDateTime}</interviewLabel>
