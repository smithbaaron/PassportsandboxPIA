    <description>Creates the Revenue Enhancement opportunity for a Price Escalation in the team's convention (name, Type, Lead Source Client Success, Amount, CS rep as owner) and links it back. Respects the exclusion flag and refuses to create a second open deal for the same clause. Called by the Create Increase Opp screen flow; kept autolaunched so it can be tested without the UI and reused by the later automatic version.</description>
    <environments>Default</environments>
    <formulas>
        <name>fCloseDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!closeDate}), IF(ISBLANK({!Get_Escalation.Next_Increase_Date__c}), {!$Flow.CurrentDate} + 30, {!Get_Escalation.Next_Increase_Date__c}), {!closeDate})</expression>
    </formulas>
    <formulas>
        <name>fIsPercentClause</name>
        <dataType>Boolean</dataType>
        <expression>OR(TEXT({!Get_Escalation.Escalator_Type__c}) = "Fixed Percentage", TEXT({!Get_Escalation.Escalator_Type__c}) = "Percentage Band", TEXT({!Get_Escalation.Escalator_Type__c}) = "CPI-Linked")</expression>
    </formulas>
    <formulas>
        <name>fPercentText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Escalation.Effective_Percentage__c}), "5", IF(FLOOR({!Get_Escalation.Effective_Percentage__c}) = {!Get_Escalation.Effective_Percentage__c}, TEXT(FLOOR({!Get_Escalation.Effective_Percentage__c})), TEXT({!Get_Escalation.Effective_Percentage__c})))</expression>
    </formulas>
    <formulas>
        <name>fOppName</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!oppName})), LEFT({!oppName}, 120), LEFT({!Get_Escalation.Account__r.Name} &amp; " - " &amp; IF({!fIsPercentClause}, {!fPercentText} &amp; "% Increase", "Contractual Increase") &amp; " Rev Enhancement - " &amp; TEXT(YEAR({!fCloseDate})), 120))</expression>
    </formulas>
    <formulas>
        <name>fAmount</name>
        <dataType>Currency</dataType>
        <expression>IF(ISBLANK({!amount}), BLANKVALUE({!Get_Escalation.Estimated_Increase_Amount__c}, BLANKVALUE({!Get_Escalation.Revenue_Impact_Next_Year__c}, 0)), {!amount})</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fRevEnhType</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!revEnhType})), {!revEnhType}, CASE(TEXT({!Get_Escalation.Primary_Product__c}), "MPP", "MPP Fee Increase", "CMP", "CMP Fee Increase", "Other"))</expression>
    </formulas>
    <formulas>
        <name>fStage</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!stage}, "Lead Qualification")</expression>
    </formulas>
    <formulas>
        <name>fOwnerId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Escalation.Client_Success_Rep__c}), {!Get_Escalation.Account__r.OwnerId}, {!Get_Escalation.Client_Success_Rep__c})</expression>
    </formulas>
    <formulas>
        <name>fNoticeDueText</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Get_Escalation.Notice_Due_Date__c}), "not set", TEXT({!Get_Escalation.Notice_Due_Date__c}))</expression>
    </formulas>
    <formulas>
        <name>fNextStep</name>
        <dataType>String</dataType>
        <expression>LEFT("Send increase notice to client by " &amp; {!fNoticeDueText} &amp; "; add the opportunity product; raise Finance ticket", 255)</expression>
    </formulas>
    <formulas>
        <name>fDescription</name>
        <dataType>String</dataType>
        <expression>"Contractual price increase per Price Escalation " &amp; {!Get_Escalation.Name} &amp; " (" &amp; TEXT({!Get_Escalation.Escalator_Type__c}) &amp; IF({!fIsPercentClause}, ", " &amp; {!fPercentText} &amp; "%", "") &amp; "). Increase effective " &amp; IF(ISBLANK({!Get_Escalation.Next_Increase_Date__c}), "date not set", TEXT({!Get_Escalation.Next_Increase_Date__c})) &amp; "; notice due " &amp; {!fNoticeDueText} &amp; ". Products: " &amp; BLANKVALUE({!Get_Escalation.Products_Covered_Detail__c}, "see clause") &amp; IF(ISBLANK({!notes}), "", BR() &amp; BR() &amp; {!notes}) &amp; BR() &amp; BR() &amp; "Clause: " &amp; LEFT(BLANKVALUE({!Get_Escalation.Clause_Text__c}, ""), 1500)</expression>
    </formulas>
    <formulas>
        <name>fExcludedMessage</name>
        <dataType>String</dataType>
        <expression>"This client is excluded from automatic increases (" &amp; BLANKVALUE({!Get_Escalation.Exclusion_Reason__c}, "status " &amp; TEXT({!Get_Escalation.Status__c})) &amp; "). Clear the exclusion on the Price Escalation first if an increase is due."</expression>
    </formulas>
    <formulas>
        <name>fExistsMessage</name>
        <dataType>String</dataType>
        <expression>"An increase opportunity is already open for this clause: " &amp; {!Get_Current_Opp.Name} &amp; " (" &amp; TEXT({!Get_Current_Opp.StageName}) &amp; "). Close it before creating another."</expression>
    </formulas>
    <formulas>
        <name>fCreatedMessage</name>
        <dataType>String</dataType>
        <expression>"Created " &amp; {!fOppName} &amp; " for " &amp; TEXT({!fAmount}) &amp; ", closing " &amp; TEXT({!fCloseDate}) &amp; "."</expression>
    </formulas>
