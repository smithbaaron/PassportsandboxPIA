<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Exclusion_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(Exclude_from_Automatic_Increases__c, LEN(Exclusion_Reason__c) = 0)</errorConditionFormula>
    <errorDisplayField>Exclusion_Reason__c</errorDisplayField>
    <errorMessage>Give an Exclusion Reason when excluding a client from automatic increases.</errorMessage>
</ValidationRule>
