<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Band_Min_Not_Above_Max</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Minimum_Percentage__c)), NOT(ISBLANK(Maximum_Percentage__c)), Minimum_Percentage__c &gt; Maximum_Percentage__c)</errorConditionFormula>
    <errorDisplayField>Minimum_Percentage__c</errorDisplayField>
    <errorMessage>Minimum Percentage cannot exceed Maximum Percentage.</errorMessage>
</ValidationRule>
