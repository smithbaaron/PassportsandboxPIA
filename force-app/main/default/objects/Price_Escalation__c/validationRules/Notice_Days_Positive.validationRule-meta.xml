<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Notice_Days_Positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Notice_Days__c)), Notice_Days__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Notice_Days__c</errorDisplayField>
    <errorMessage>Notice Days must be greater than zero.</errorMessage>
</ValidationRule>
