<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Notice_Due_Date__c</fullName>
    <externalId>false</externalId>
    <inlineHelpText>Next Increase Date minus Notice Days: the last day to send the client notice.</inlineHelpText>
    <label>Notice Due Date</label>
    <formula>IF(ISBLANK(Next_Increase_Date__c), NULL, Next_Increase_Date__c - BLANKVALUE(Notice_Days__c, 60))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <trackTrending>false</trackTrending>
    <type>Date</type>
</CustomField>
